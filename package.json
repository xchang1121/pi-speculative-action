{
	"name": "@earendil-works/pi-speculative-action",
	"version": "0.84.1",
	"description": "Zero-modification speculative-action package for Pi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"import": "./dist/core.js"
		},
		"./extension": {
			"types": "./dist/extension.d.ts",
			"import": "./dist/extension.js"
		},
		"./pattern-aware": {
			"types": "./dist/pattern-aware.d.ts",
			"import": "./dist/pattern-aware.js"
		},
		"./process-reuse": {
			"types": "./dist/process-reuse.d.ts",
			"import": "./dist/process-reuse.js"
		},
		"./package.json": "./package.json"
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"README-CN.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"check": "tsc --noEmit -p tsconfig.json",
		"build": "shx rm -rf dist && tsc -p tsconfig.build.json && shx cp src/process-dispatcher.mjs dist/process-dispatcher.mjs && shx cp src/process-namespace-launcher.mjs dist/process-namespace-launcher.mjs",
		"bench:ablation": "tsx ./bench/run.ts",
		"bench:suite": "tsx ./bench/suite.ts",
		"bench:tape": "tsx ./bench/tape.ts",
		"bench:check": "tsc --noEmit -p ./bench/tsconfig.json",
		"bench:linux-process": "tsx ./bench/linux-process-reuse.ts",
		"bench:linux-pathset": "tsx ./bench/linux-process-pathset.ts",
		"bench:linux-artifacts": "tsx ./bench/linux-process-artifact-closure.ts",
		"bench:linux-topology": "tsx ./bench/linux-process-topology-reuse.ts",
		"bench:linux-admission": "tsx ./bench/linux-process-admission.ts",
		"bench:linux-inflight": "tsx ./bench/linux-process-inflight.ts",
		"bench:exec-boundary": "tsx ./bench/linux-exec-boundary.ts",
		"bench:overlay-probe": "sh ./bench/overlayfs-capability-probe.sh",
		"bench:overlay-view": "tsx ./bench/overlayfs-namespace-view.ts",
		"setup:linux": "node ./src/setup-linux-process-backend.mjs",
		"test": "vitest --run",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@types/node": "24.12.4",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"typebox": "1.3.7",
		"typescript": "5.9.3",
		"vite": "8.0.16",
		"vitest": "4.1.9"
	},
	"keywords": [
		"pi-package",
		"ai",
		"agent",
		"speculative-execution",
		"tool-use"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xchang1121/pi.git"
	},
	"bugs": {
		"url": "https://github.com/xchang1121/pi/issues"
	},
	"homepage": "https://github.com/xchang1121/pi#readme",
	"engines": {
		"node": ">=22.19.0"
	}
}
