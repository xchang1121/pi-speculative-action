{
	"name": "@earendil-works/pi-speculative-action",
	"version": "0.84.1",
	"description": "Zero-modification speculative-action package for Pi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"import": "./dist/core.js"
		},
		"./extension": {
			"types": "./dist/extension.d.ts",
			"import": "./dist/extension.js"
		},
		"./pattern-aware": {
			"types": "./dist/pattern-aware.d.ts",
			"import": "./dist/pattern-aware.js"
		},
		"./process-reuse": {
			"types": "./dist/process-reuse.d.ts",
			"import": "./dist/process-reuse.js"
		},
		"./thinkthread-extension": {
			"types": "./dist/thinkthread/index.d.ts",
			"import": "./dist/thinkthread/index.js"
		},
		"./package.json": "./package.json"
	},
	"pi": {
		"extensions": [
			"./dist/extension.js"
		]
	},
	"files": [
		"dist",
		"src",
		".thinkthread",
		"vendor",
		"scripts/install-thinkthread-profile.sh",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
		"check": "tsc --noEmit -p tsconfig.json",
		"build": "npm run clean && tsc -p tsconfig.build.json --noCheck && node -e \"for (const name of ['closed-search-kernel.mjs','closed-search-process.mjs']) require('node:fs').copyFileSync('src/'+name, 'dist/'+name)\"",
		"bench:ablation": "tsx ./bench/run.ts",
		"bench:suite": "tsx ./bench/suite.ts",
		"bench:check": "tsc --noEmit -p ./bench/tsconfig.json",
		"bench:exec-boundary": "vitest --run test/bash-closure.test.ts test/extension.system.test.ts --maxWorkers=1 --no-file-parallelism",
		"bench:overlay-probe": "vitest --run test/linux-overlayfs.test.ts --maxWorkers=1 --no-file-parallelism",
		"setup:linux": "node ./src/setup-linux-process-backend.mjs",
		"build:windows": "node ./src/setup-windows-filesystem.mjs",
		"test": "vitest --run",
		"prepare": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@thinkthread/agent-posix": "0.1.0"
	},
	"peerDependenciesMeta": {
		"@thinkthread/agent-posix": {
			"optional": true
		}
	},
	"dependencies": {
		"@types/node": "24.12.4",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@thinkthread/agent-posix": "file:vendor/thinkthread-agent-posix-0.1.0.tgz",
		"tsx": "4.22.1",
		"typebox": "1.3.7",
		"vite": "8.0.16",
		"vitest": "4.1.9"
	},
	"keywords": [
		"pi-package",
		"ai",
		"agent",
		"speculative-execution",
		"tool-use"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xchang1121/pi-speculative-action.git"
	},
	"bugs": {
		"url": "https://github.com/xchang1121/pi-speculative-action/issues"
	},
	"homepage": "https://github.com/xchang1121/pi-speculative-action#readme",
	"engines": {
		"node": ">=22.19.0"
	}
}
