{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"lib": ["ES2022"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"inlineSources": true,
		"inlineSourceMap": false,
		"moduleResolution": "Node16",
		"paths": {
			"@earendil-works/pi-speculative-action": ["./src/index.ts"],
			"@earendil-works/pi-speculative-action/extension": ["./src/extension.ts"]
		},
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"rewriteRelativeImportExtensions": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"useDefineForClassFields": false,
		"types": ["node"],
		"noEmit": true
	},
	"include": ["src/**/*.ts", "src/process-context.mjs", "test/**/*.ts", "examples/**/*.ts", "vitest.config.ts"],
	"exclude": ["node_modules", "dist"]
}
