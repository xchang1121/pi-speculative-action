@@ -0,0 +1,419 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { AgentExecutionInterrupted, type AgentTool, type AgentToolCallReceipt } from "@earendil-works/pi-agent-core";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it } from "vitest";
+import type {
+	SessionExecutionController,
+	SessionExecutionScope,
+	SessionToolCall,
+} from "../../src/core/agent-session.ts";
+import { SessionManager } from "../../src/core/session-manager.ts";
+import { createHarness, getMessageText, type Harness, type HarnessOptions } from "./harness.ts";
+
+function gate() {
+	let resolve = () => {};
+	const promise = new Promise<void>((yes) => {
+		resolve = yes;
+	});
+	return { promise, resolve };
+}
+
+// An in-memory protocol oracle: these tests establish SDK ordering, not cross-process authority.
+class Controller implements SessionExecutionController {
+	receipts = new Map<string, AgentToolCallReceipt>();
+	admitted: SessionToolCall[] = [];
+	acknowledged: string[] = [];
+	closed: unknown[] = [];
+	acquisitions = 0;
+	valid = true;
+	deny = false;
+	denyIndex?: number;
+	before?: () => Promise<void>;
+	cut?: { index: number; afterAppend: boolean };
+
+	async acquire(): Promise<SessionExecutionScope> {
+		this.acquisitions++;
+		await this.before?.();
+		if (this.deny) throw new Error("owner already active");
+		let closed = false;
+		const key = (request: SessionToolCall) => `${request.sessionId}:${request.assistantEntryId}:${request.index}`;
+		return {
+			assertActive: () => {
+				if (closed || !this.valid) throw new Error("execution fenced");
+			},
+			beforeToolCall: async (request) => {
+				this.admitted.push(request);
+				if (request.index === this.denyIndex) throw new Error("later claim unavailable");
+				return this.receipts.get(key(request));
+			},
+			persistToolResult: async (request, receipt, append) => {
+				const saved = JSON.parse(JSON.stringify(receipt)) as AgentToolCallReceipt;
+				this.receipts.set(key(request), saved);
+				const cut = this.cut?.index === request.index ? this.cut : undefined;
+				if (cut && !cut.afterAppend) throw new Error("lost before append");
+				const entry = append();
+				if (cut) throw new Error("lost before acknowledgement");
+				this.acknowledged.push(entry);
+			},
+			close: async (error) => {
+				closed = true;
+				this.closed.push(error);
+			},
+		};
+	}
+}
+
+describe("AgentSession execution authority and receipt delivery", () => {
+	const harnesses: Harness[] = [];
+	const directories: string[] = [];
+	async function harness(options?: HarnessOptions) {
+		const value = await createHarness(options);
+		harnesses.push(value);
+		return value;
+	}
+	afterEach(async () => {
+		for (const value of harnesses.splice(0)) {
+			await value.session.close();
+			value.cleanup();
+		}
+		for (const directory of directories.splice(0)) rmSync(directory, { recursive: true });
+	});
+
+	it.each(["hello", "/command"])("rejects %s before input, command, model, events, or persistence", async (text) => {
+		const effects: string[] = [];
+		const value = await harness({
+			extensionFactories: [
+				(pi) => {
+					pi.on("input", () => {
+						effects.push("input");
+					});
+					pi.registerCommand("command", {
+						description: "test",
+						handler: async () => {
+							effects.push("command");
+						},
+					});
+				},
+			],
+		});
+		value.setResponses([
+			() => {
+				effects.push("model");
+				return fauxAssistantMessage("done");
+			},
+		]);
+		const controller = new Controller();
+		controller.deny = true;
+		value.session.setExecutionController(controller);
+		const entries = value.sessionManager.getEntries().slice();
+		await expect(value.session.prompt(text)).rejects.toBeInstanceOf(AgentExecutionInterrupted);
+		await expect(value.session.agent.prompt("bypass")).rejects.toBeInstanceOf(AgentExecutionInterrupted);
+		expect(effects).toEqual([]);
+		expect(value.events).toEqual([]);
+		expect(value.sessionManager.getEntries()).toEqual(entries);
+	});
+
+	it("checks authority between extension handlers without emitting an error callback", async () => {
+		const controller = new Controller();
+		const effects: string[] = [];
+		const value = await harness({
+			extensionFactories: [
+				(pi) => {
+					pi.on("input", async () => {
+						effects.push("first");
+						controller.valid = false;
+					});
+					pi.on("input", () => {
+						effects.push("second");
+					});
+				},
+			],
+		});
+		await value.session.bindExtensions({ onError: () => effects.push("error") });
+		value.session.setExecutionController(controller);
+		await expect(value.session.prompt("hello")).rejects.toBeInstanceOf(AgentExecutionInterrupted);
+		expect(effects).toEqual(["first"]);
+		expect(value.events).toEqual([]);
+	});
+
+	for (const mode of ["sequential", "parallel"] as const) {
+		it.each([false, true])(`${mode}: recovers the exact saved batch, afterAppend=%s`, async (afterAppend) => {
+			const directory = mkdtempSync(join(tmpdir(), "pi-receipts-"));
+			directories.push(directory);
+			const controller = new Controller();
+			controller.cut = { index: 3, afterAppend };
+			const effects: string[] = [];
+			const tool: AgentTool = {
+				name: "echo",
+				label: "echo",
+				description: "echo",
+				parameters: Type.Object({ value: Type.String() }),
+				prepareArguments: (args) => {
+					effects.push("prepare");
+					return args;
+				},
+				execute: async () => {
+					effects.push("execute");
+					return { content: [{ type: "text", text: "raw" }], details: {}, terminate: true };
+				},
+			};
+			const make = async (sessionManager: SessionManager) => {
+				const value = await harness({
+					sessionManager,
+					tools: [tool],
+					extensionFactories: [
+						(pi) => {
+							pi.on("input", () => {
+								effects.push("input");
+							});
+							pi.on("tool_call", () => {
+								effects.push("call");
+							});
+							pi.on("tool_result", () => {
+								effects.push("result");
+								return { content: [{ type: "text", text: "result-hook" }] };
+							});
+							pi.on("message_end", (event) => {
+								if (event.message.role !== "toolResult") return;
+								effects.push("message");
+								return { message: { ...event.message, content: [{ type: "text", text: "final-hook" }] } };
+							});
+						},
+					],
+				});
+				value.session.agent.toolExecution = mode;
+				value.session.setExecutionController(controller);
+				value.session.subscribe((event) => {
+					if (event.type === "message_end" && event.message.role === "toolResult") {
+						effects.push("listener");
+						event.message.details = { listener: true };
+					}
+				});
+				return value;
+			};
+			const batch = () =>
+				fauxAssistantMessage(
+					[
+						{ type: "text", text: "first" },
+						fauxToolCall("echo", { value: "one" }, { id: "duplicate" }),
+						{ type: "text", text: "second" },
+						fauxToolCall("echo", { value: "two" }, { id: "duplicate" }),
+					],
+					{ stopReason: "toolUse" },
+				);
+			const original = await make(SessionManager.create(directory, directory));
+			original.setResponses([batch()]);
+			await expect(original.session.prompt("run")).rejects.toBeInstanceOf(AgentExecutionInterrupted);
+			expect(effects.filter((effect) => effect === "execute")).toHaveLength(2);
+			expect(controller.admitted.map((request) => request.index)).toEqual([1, 3]);
+			const finalEffects = effects.slice();
+			const file = original.session.sessionFile!;
+			await original.session.close();
+			controller.cut = undefined;
+			const recovered = await make(SessionManager.open(file));
+			const acknowledged = controller.acknowledged.length;
+			controller.denyIndex = 3;
+			await expect(recovered.session.resumeTools()).rejects.toBeInstanceOf(AgentExecutionInterrupted);
+			expect(controller.acknowledged).toHaveLength(acknowledged + 1);
+			expect(effects).toEqual(finalEffects);
+			controller.denyIndex = undefined;
+			recovered.setResponses([
+				() => {
+					throw new Error("must not request a replacement model response");
+				},
+			]);
+			await recovered.session.resumeTools();
+			expect(effects).toEqual(finalEffects);
+			const results = recovered.session.messages.filter((message) => message.role === "toolResult");
+			expect(results).toHaveLength(2);
+			expect(results.map(getMessageText)).toEqual(["final-hook", "final-hook"]);
+			expect(results.map((message) => message.details)).toEqual([{ listener: true }, { listener: true }]);
+			expect(recovered.eventsOfType("message_end")).toEqual([]);
+			expect(recovered.eventsOfType("turn_start")).toEqual([]);
+			expect(recovered.eventsOfType("turn_end")).toHaveLength(afterAppend ? 0 : 1);
+			expect(new Set(controller.acknowledged).size).toBe(2);
+			const entries = recovered.sessionManager.getEntries().slice();
+			await recovered.session.resumeTools();
+			expect(recovered.sessionManager.getEntries()).toEqual(entries);
+			recovered.setResponses([batch()]);
+			await recovered.session.prompt("new request with the same call IDs");
+			expect(effects.filter((effect) => effect === "execute")).toHaveLength(4);
+			expect(controller.receipts.size).toBe(4);
+		});
+	}
+
+	it("resumes an admitted but unstarted request through the original prepare and tool pipeline", async () => {
+		const controller = new Controller();
+		const effects: string[] = [];
+		const value = await harness({
+			tools: [
+				{
+					name: "echo",
+					label: "echo",
+					description: "echo",
+					parameters: Type.Object({}),
+					prepareArguments: (args) => {
+						effects.push("prepare");
+						return args;
+					},
+					execute: async () => {
+						effects.push("execute");
+						return { content: [], details: {}, terminate: true };
+					},
+				},
+			],
+		});
+		const acquire = controller.acquire.bind(controller);
+		let rejectCall = true;
+		value.session.setExecutionController({
+			acquire: async () => {
