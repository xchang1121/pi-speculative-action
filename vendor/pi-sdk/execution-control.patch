+/** Continue the actual unfinished batch, without repeating its prompt, assistant, or start events. */
+export async function runAgentLoopResumeTools(
+	context: AgentContext,
+	config: AgentLoopConfig,
+	emit: AgentEventSink,
+	signal: AbortSignal | undefined,
+	streamFn: StreamFn,
+): Promise<AgentMessage[]> {
+	let position = context.messages.length - 1;
+	while (position >= 0 && context.messages[position].role !== "assistant") position--;
+	const message = context.messages[position];
+	if (!message || message.role !== "assistant" || ["error", "aborted"].includes(message.stopReason)) {
+		throw new AgentExecutionInterrupted("No pending assistant tool batch");
+	}
+	const calls = message.content.filter((part) => part.type === "toolCall");
+	const completed = context.messages.slice(position + 1);
+	if (
+		!calls.length ||
+		completed.length > calls.length ||
+		completed.some(
+			(result, index) =>
+				result.role !== "toolResult" ||
+				result.toolCallId !== calls[index].id ||
+				result.toolName !== calls[index].name,
+		)
+	) {
+		throw new AgentExecutionInterrupted("Transcript is not an unfinished tool-result prefix");
+	}
+	const newMessages: AgentMessage[] = [];
+	await runLoop(
+		{ ...context, messages: context.messages.slice() },
+		newMessages,
+		config,
+		signal,
+		emit,
+		streamFn ?? getDefaultStreamFn(),
+		{ message, completed: completed as ToolResultMessage[] },
+	);
+	return newMessages;
+}
