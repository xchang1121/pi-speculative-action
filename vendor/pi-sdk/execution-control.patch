+			},
+		});
+		value.setResponses([fauxAssistantMessage(fauxToolCall("echo", {}), { stopReason: "toolUse" })]);
+		await expect(value.session.prompt("start")).rejects.toBeInstanceOf(AgentExecutionInterrupted);
+		expect(effects).toEqual([]);
+		expect(value.eventsOfType("tool_execution_start")).toEqual([]);
+		rejectCall = false;
+		await value.session.resumeTools();
+		expect(effects).toEqual(["prepare", "execute"]);
+		expect(value.session.messages.map((message) => message.role)).toEqual(["user", "assistant", "toolResult"]);
+	});
+
+	it.each(["tool", "update"])(
+		"drains parallel %s callbacks before closing after a control interruption",
+		async (source) => {
+			const entered = gate(),
+				release = gate(),
+				failed = gate();
+			const controller = new Controller();
+			const tools: AgentTool[] = (source === "update" ? ["updates"] : ["slow", "fail"]).map((name) => ({
+				name,
+				label: name,
+				description: name,
+				parameters: Type.Object({}),
+				execute: async (_id, _args, _signal, onUpdate) => {
+					if (source === "update") {
+						onUpdate?.({ content: [], details: { name: "slow" } });
+						onUpdate?.({ content: [], details: { name: "fail" } });
+						return { content: [], details: {} };
+					}
+					if (name === "fail") {
+						failed.resolve();
+						throw new AgentExecutionInterrupted("fenced");
+					}
+					entered.resolve();
+					await release.promise;
+					return { content: [], details: {} };
+				},
+			}));
+			const value = await harness({ tools });
+			value.session.agent.subscribe(async (event) => {
+				if (source !== "update" || event.type !== "tool_execution_update") return;
+				if (event.partialResult.details?.name === "fail") {
+					failed.resolve();
+					throw new AgentExecutionInterrupted("update fenced");
+				}
+				entered.resolve();
+				await release.promise;
+			});
+			value.session.agent.toolExecution = "parallel";
+			value.session.setExecutionController(controller);
+			value.setResponses([
+				fauxAssistantMessage(
+					tools.map((tool) => fauxToolCall(tool.name, {}, { id: tool.name })),
+					{ stopReason: "toolUse" },
+				),
+			]);
+			const run = value.session.prompt("start");
+			const rejected = expect(run).rejects.toBeInstanceOf(AgentExecutionInterrupted);
+			await Promise.all([entered.promise, failed.promise]);
+			await new Promise(setImmediate);
+			const closedBeforeDrain = controller.closed.length;
+			const closing = value.session.close();
+			release.resolve();
+			await rejected;
+			await closing;
+			expect(closedBeforeDrain).toBe(0);
+			expect(controller.closed).toHaveLength(1);
+			expect(value.eventsOfType("agent_settled")).toEqual([]);
+		},
+	);
+
+	it("closes a pending acquisition before it can enter preflight", async () => {
+		const entered = gate(),
+			release = gate();
+		const controller = new Controller();
+		controller.before = async () => {
+			entered.resolve();
+			await release.promise;
+		};
+		const value = await harness();
+		value.session.setExecutionController(controller);
+		const run = expect(value.session.prompt("start")).rejects.toBeInstanceOf(AgentExecutionInterrupted);
+		await entered.promise;
+		expect(() => value.session.setExecutionController(new Controller())).toThrow(AgentExecutionInterrupted);
+		const closing = value.session.close();
+		release.resolve();
+		await run;
+		await closing;
+		expect(controller.closed).toHaveLength(1);
+		expect(value.events).toEqual([]);
+	});
+
+	it("drains unawaited nested session work and rejects callbacks that outlive the scope", async () => {
+		const entered = gate(),
+			release = gate(),
+			late = gate();
+		const controller = new Controller();
+		let delayed: Promise<void> | undefined;
+		let value: Harness;
+		value = await harness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerCommand("nested", {
+						description: "test",
+						handler: async () => {
+							void value.session.sendCustomMessage(
+								{ customType: "nested", content: "run", display: false },
+								{ triggerTurn: true },
+							);
+							delayed = late.promise.then(() =>
+								value.session.sendCustomMessage({ customType: "late", content: "late", display: false }),
+							);
+						},
+					});
+				},
+			],
+		});
+		value.session.setExecutionController(controller);
+		value.setResponses([
+			async () => {
+				entered.resolve();
+				await release.promise;
+				return fauxAssistantMessage("done");
+			},
+		]);
+		const run = value.session.prompt("/nested");
+		await entered.promise;
+		expect(controller.closed).toEqual([]);
+		release.resolve();
+		await run;
+		expect(controller.acquisitions).toBe(1);
+		expect(controller.closed).toHaveLength(1);
+		const rejected = expect(delayed).rejects.toBeInstanceOf(AgentExecutionInterrupted);
+		late.resolve();
+		await rejected;
+		expect(value.session.messages.filter((message) => message.role === "custom")).toHaveLength(1);
+	});
+});
