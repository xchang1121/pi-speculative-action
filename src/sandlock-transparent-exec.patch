+        if image.path != original_path { return Err(invalid()); }
+        let parse = |row: &[String; 14]| row.iter().map(|value| value.parse::<i128>()).collect::<Result<Vec<_>, _>>()
+            .map_err(|_| invalid()).map(|values| <[i128; 14]>::try_from(values).unwrap());
+        let (physical, original) = (parse(&image.physical)?, parse(&image.original)?);
+        let current = OpenOptions::new().read(true).custom_flags(libc::O_PATH | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(cow.resolve_read(original_path.trim_start_matches('/')))?;
+        if descriptor_fields(current.as_raw_fd())?[..2] != physical[..2] { return Err(invalid()); }
+        metadata.objects.write().unwrap().insert((physical[0] as u64, physical[1] as u64), (physical, original));
+        index_input_image(&images, original_path, requested, &key, true)?;
+        Ok(())
+    })();
+    if result.is_err() {
+        // A failed later open must not inherit an earlier path's sealed input authority.
+        for name in [original_path, requested] {
+            let index = images.join("paths").join(format!("{}.json", input_key(name)));
