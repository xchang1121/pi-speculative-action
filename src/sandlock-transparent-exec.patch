+/// Stop every thread of `pid` that could run user code. The vfork waiter sits in an uninterruptible wait (`D`) and
+/// meets the pending stop before it returns to user space. A process-directed stop can be queued to that waiter, which
+/// does not wake for it, and never reach the other threads: it goes to each thread, and the first to take it stops the
+/// group (SIGCONT discards the rest).
+fn stop_process(pid: u32) -> io::Result<()> {
+    if unsafe { libc::kill(pid as libc::pid_t, libc::SIGSTOP) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    for task in std::fs::read_dir(format!("/proc/{}/task", pid))?.filter_map(Result::ok) {
+        if let Some(tid) = task.file_name().to_str().and_then(|name| name.parse::<libc::c_long>().ok()) {
+            unsafe { libc::syscall(libc::SYS_tgkill, pid as libc::c_long, tid, libc::SIGSTOP as libc::c_long) };
+        }
+    }
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+    loop {
+        let running = std::fs::read_dir(format!("/proc/{}/task", pid))?.filter_map(Result::ok).any(|task| {
+            std::fs::read_to_string(task.path().join("stat"))
+                .ok()
+                .and_then(|stat| stat.rsplit_once(") ").and_then(|(_, rest)| rest.bytes().next()))
