+                    Ok(value) => value.parse().map_err(|_| std::io::Error::from_raw_os_error(libc::EAGAIN))?,
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => 0,
+                    Err(error) => return Err(error),
