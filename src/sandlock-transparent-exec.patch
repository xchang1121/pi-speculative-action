+    let line = &line[line.iter().position(|b| !blank(b))?..=line.iter().rposition(|b| !blank(b))?];
+    let (interpreter, rest) = line.split_at(line.iter().position(blank).unwrap_or(line.len()));
+    let argument = rest.iter().position(|b| !blank(b)).map(|start| rest[start..].to_vec());
