+            index_input_image(&images, original_path, requested, &key, false)?;
+            if !cow.install_input(original_path, &working)? { return Err(invalid()); }
+            let image = InputImage { path: original_path.to_string(), physical: descriptor_fields(writable.as_raw_fd())?.map(|value| value.to_string()),
+                original: original.map(|value| value.to_string()) };
