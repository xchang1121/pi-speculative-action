+    #[test]
+    fn input_images_follow_the_opened_object_and_retire_changed_paths() {
+        let root = tempfile::tempdir().unwrap();
+        let original = root.path().join("original");
+        let alias = root.path().join("alias");
+        fs::write(&original, b"original").unwrap(); symlink(&original, &alias).unwrap();
+        let mut cow = crate::cow::seccomp::SeccompCowBranch::create(Path::new("/"), Some(root.path()), 0).unwrap();
+        let metadata = MetadataImage::default();
+        let name = original.to_str().unwrap();
+        // This unprivileged owner cannot reproduce a system object's ownership; no copied mode may grant W_OK.
+        let system = Path::new("/usr/bin/true");
+        let before = fs::metadata(system).unwrap();
+        if unsafe { libc::geteuid() } != 0 && std::os::unix::fs::MetadataExt::uid(&before) != unsafe { libc::geteuid() } {
+            assert!(capture_input_image(&mut cow, system, system.to_str().unwrap(), &metadata).is_err());
+            assert_eq!(cow.resolve_read("usr/bin/true"), system);
+        }
+        capture_input_image(&mut cow, &original, alias.to_str().unwrap(), &metadata).unwrap();
+        let images = cow.upper_dir().parent().unwrap().join("inputs");
+        let index = |path: &Path| -> serde_json::Value {
+            serde_json::from_slice(&fs::read(images.join("paths").join(format!("{}.json", input_key(path.to_str().unwrap())))).unwrap()).unwrap()
+        };
+        let current = cow.resolve_read(name.trim_start_matches('/'));
+        assert_eq!(fs::read(&current).unwrap(), b"original");
+        fs::write(&original, b"new host bytes").unwrap();
+        capture_input_image(&mut cow, &original, name, &metadata).unwrap();
+        assert_eq!(fs::read(&current).unwrap(), b"original");
+        assert_eq!(index(&original)["sealed"], true);
+        fs::remove_file(&alias).unwrap(); symlink("/dev/null", &alias).unwrap();
+        assert!(capture_input_image(&mut cow, Path::new("/dev/null"), alias.to_str().unwrap(), &metadata).is_err());
+        assert_eq!(index(&alias)["ambiguous"], true);
+        let replacement = root.path().join("replacement"); fs::write(&replacement, b"private bytes").unwrap();
+        fs::rename(&replacement, &current).unwrap();
+        assert!(capture_input_image(&mut cow, &original, name, &metadata).is_err());
+        assert_eq!(index(&original)["ambiguous"], true);
+        assert_eq!(fs::read(&current).unwrap(), b"private bytes");
+        assert_eq!(fs::read(&original).unwrap(), b"new host bytes");
+        fs::write(images.join("indexes"), "8192").unwrap();
+        symlink(&original, &replacement).unwrap();
