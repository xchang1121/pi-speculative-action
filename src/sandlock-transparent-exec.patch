+            fs::copy(&baseline, &working)?;
+            writable.set_permissions(fs::Permissions::from_mode(original[2] as u32 & 0o7777))?;
+            let stamps = [original[10], original[11]].map(|value| libc::timespec {
+                tv_sec: value.div_euclid(1_000_000_000) as _, tv_nsec: value.rem_euclid(1_000_000_000) as _ });
+            if unsafe { libc::futimens(writable.as_raw_fd(), stamps.as_ptr()) } != 0 { return Err(invalid()); }
