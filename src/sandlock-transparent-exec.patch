+    fn copied_access_time_respects_source_policy_and_mutations() {
+        let second = 1_000_000_000;
+        let physical = [1, 2, libc::S_IFREG as i128 | 0o644, 1, 1000, 1000, 0, 4, 4096, 8, 20 * second, 10 * second, 30 * second, 0];
+        let mut original = physical;
+        original[1] = 7; original[12] = 15 * second;
+        for (policy, changed, access, expected) in [
+            (0, false, 40 * second, 40 * second),
+            (1, false, 40 * second, 20 * second),
+            (2, false, 40 * second, 20 * second),
+            (2, false, 86420 * second, 86420 * second),
+            (2, true, 40 * second, 40 * second),
+        ] {
+            let image = MetadataImage::from_rows(vec![(physical, original, policy)]).unwrap();
+            let mut observed = physical; observed[10] = access;
+            if changed { observed[12] += second; }
+            image.project(&mut observed);
+            assert_eq!(observed[1], 7); assert_eq!(observed[10], expected);
+        }
+        original[10] = original[12];
+        let image = MetadataImage::from_rows(vec![(physical, original, 2)]).unwrap();
+        let mut observed = physical; observed[10] = 40 * second;
+        image.project(&mut observed); assert_eq!(observed[10], 40 * second);
+        assert!(MetadataImage::from_rows(vec![(physical, original, 3)]).is_err());
+    }
