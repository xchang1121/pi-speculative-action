+/// Open for the child, giving a file this open creates exactly `mode` (the supervisor's umask must not narrow it) and
+/// leaving an existing file's untouched: an open that may create first tries to create exclusively.
+fn open_creating(open: impl Fn(i32, u32) -> Result<OwnedFd, i32>, flags: i32, mode: u32) -> Result<OwnedFd, i32> {
+    let exact = |fd: OwnedFd| if unsafe { libc::fchmod(fd.as_raw_fd(), mode) } == 0 { Ok(fd) } else { Err(last_errno(libc::EIO)) };
+    if flags & libc::O_TMPFILE == libc::O_TMPFILE || flags & (libc::O_CREAT | libc::O_EXCL) == libc::O_CREAT | libc::O_EXCL {
+        return open(flags, mode).and_then(exact);
