+    /// Fix the cwd `pid`'s unregistered children start with at its current
+    /// one while they are still its children. A child registers at its first
+    /// notification and copies its parent's cwd then, but by then the parent
+    /// may have moved, or exited and left the child to a reaper that says
+    /// nothing of where it was (`(cmd &)` in a subshell), which would leave
+    /// the child in the kernel's cwd, one chdir never moves. So a task
+    /// settles its children before it moves and before it exits.
+    pub fn settle_children(&self, pid: i32) {
+        let cwd = self.virtual_cwd(pid);
+        let Ok(tasks) = std::fs::read_dir(format!("/proc/{pid}/task")) else { return };
+        let children: Vec<i32> = tasks
+            .filter_map(Result::ok)
+            .filter_map(|task| std::fs::read_to_string(task.path().join("children")).ok())
+            .flat_map(|list| list.split_whitespace().filter_map(|child| child.parse().ok()).collect::<Vec<i32>>())
+            .filter(|&child| !self.contains(child))
+            .collect();
+        let Ok(mut settled) = self.settled.lock() else { return };
+        // A child that exits without a notification leaves its entry behind.
+        if settled.len() > 1024 {
+            settled.retain(|&child, (start, _)| read_pid_start_time(child) == Some(*start));
+        }
+        for child in children {
+            if let (std::collections::hash_map::Entry::Vacant(slot), Some(start)) = (settled.entry(child), read_pid_start_time(child)) {
+                slot.insert((start, cwd.clone()));
+            }
+        }
+    }
+
+    fn settled_cwd(&self, pid: i32, start_time: u64) -> Option<SharedCwd> {
+        let (start, cwd) = self.settled.lock().ok()?.remove(&pid)?;
+        (start == start_time).then(|| Arc::new(std::sync::Mutex::new(cwd)))
+    }
