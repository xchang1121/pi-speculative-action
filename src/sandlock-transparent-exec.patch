+            let usage = fs::read_to_string(&usage_path).unwrap_or_default();
+            let usage: Vec<u64> = usage.split_whitespace().filter_map(|value| value.parse().ok()).collect();
+            let (bytes, count) = (usage.first().copied().unwrap_or(0), usage.get(1).copied().unwrap_or(0));
+            if count >= 4096 || bytes + original[7] as u64 * 2 > 256 * 1024 * 1024 { return Err(invalid()); }
+            fs::create_dir(&directory)?;
+            fs::write(&usage_path, format!("{} {}", bytes, count + 1))?;
+            let baseline = directory.join("baseline");
+            let working = directory.join("working");
+            let writable = OpenOptions::new().write(true).create_new(true).mode(0o600).open(&working)?;
+            // Preserve kernel permission queries as well as reported metadata. If the owner cannot construct this
+            // ownership, the original object remains the read source and no input image grants it new authority.
+            if unsafe { libc::fchown(writable.as_raw_fd(), original[4] as _, original[5] as _) } != 0 { return Err(invalid()); }
+            fs::write(&usage_path, format!("{} {}", bytes + original[7] as u64 * 2, count + 1))?;
+            let mut source = OpenOptions::new().read(true).open(format!("/proc/self/fd/{}", source.as_raw_fd()))?;
+            let mut captured = OpenOptions::new().write(true).create_new(true).mode(0o600).open(&baseline)?;
+            let bytes = std::io::copy(&mut std::io::Read::by_ref(&mut source).take(original[7] as u64 + 1), &mut captured)?;
+            let after = descriptor_fields(source.as_raw_fd())?;
