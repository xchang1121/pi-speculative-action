+                    let temporary = images.join("publishing");
+                    fs::write(&temporary, serde_json::to_vec(&serde_json::json!({ "path": name, "ambiguous": true }))?)?;
+                    fs::rename(temporary, index)?;
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {},
+                Err(error) => return Err(error),
+            }
+        }
+    }
+    result
+}
