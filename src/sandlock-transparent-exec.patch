+/// The kernel's permission check for this user, on the host object a write would change.
+fn natively_writable(host_path: &Path, kind: WriteKind) -> bool {
+    use std::os::unix::fs::MetadataExt;
+    let access = |path: &Path, mode: i32| CString::new(path.as_os_str().as_encoded_bytes()).map_or(false, |c|
+        unsafe { libc::faccessat(libc::AT_FDCWD, c.as_ptr(), mode, libc::AT_EACCESS | libc::AT_SYMLINK_NOFOLLOW) } == 0);
+    let uid = unsafe { libc::geteuid() };
+    let existing = std::fs::symlink_metadata(host_path).ok();
+    match (kind, &existing) {
+        // A device, FIFO or socket is not content the branch can hold: only the policy grants writing one.
+        (WriteKind::Content, Some(meta)) if !meta.file_type().is_symlink() => (meta.is_file() || meta.is_dir()) && access(host_path, libc::W_OK),
+        (WriteKind::Owner, Some(meta)) => meta.uid() == uid,
+        _ => match host_path.parent() {
+            // A parent the host lacks exists only in the branch, which the child made.
+            Some(parent) => match std::fs::metadata(parent) {
+                Err(_) => true,
+                // A sticky directory lets only an entry's owner (or the directory's) remove or rename it.
+                Ok(dir) => access(parent, libc::W_OK | libc::X_OK) && (dir.mode() & libc::S_ISVTX == 0 || existing.map_or(true, |e| e.uid() == uid) || dir.uid() == uid),
+            },
+            None => false,
+        },
+    }
