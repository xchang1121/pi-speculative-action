+/// binfmt_script's reading of a `#!` line (fs/binfmt_script.c): the interpreter, then at most one argument, from
+/// the first line within the first 256 bytes, surrounding blanks trimmed. None for anything else.
+fn read_shebang(fd: RawFd) -> Option<(Vec<u8>, Option<Vec<u8>>)> {
+    let mut head = [0u8; 256];
+    let read = unsafe { libc::pread(fd, head.as_mut_ptr().cast(), head.len(), 0) };
+    if read < 3 || head[..2] != *b"#!" {
+        return None;
+    }
+    let line = &head[2..read as usize];
+    // A short file may end its only line without a newline.
+    let line = &line[..line.iter().position(|&b| b == b'\n' || b == 0).or((read < 256).then_some(line.len()))?];
+    let blank = |b: &u8| *b == b' ' || *b == b'\t';
+    let line = &line[line.iter().position(|b| !blank(b))?..=line.iter().rposition(|b| !blank(b))?];
+    let (interpreter, rest) = line.split_at(line.iter().position(blank).unwrap_or(line.len()));
+    let argument = rest.iter().position(|b| !blank(b)).map(|start| rest[start..].to_vec());
+    Some((interpreter.to_vec(), argument))
+}
