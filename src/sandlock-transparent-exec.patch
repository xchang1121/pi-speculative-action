+/// Open an executable where the view finds it: under its mount, else under the root.
+fn open_in_view(ctx: &ChrootCtx<'_>, virtual_path: &Path) -> Option<RawFd> {
+    let (root, path) = match ctx.mount_target(virtual_path) {
+        Some((mount, sub)) => (mount.to_path_buf(), sub),
+        None => (ctx.root.to_path_buf(), virtual_path.to_string_lossy().to_string()),
+    };
