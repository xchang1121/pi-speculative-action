+/// Where a write to `host_path` lands: a copy the branch makes first when the path is its own, else the path itself.
+async fn write_target(cow_state: &Arc<Mutex<CowState>>, host_path: &Path) -> Result<PathBuf, NotifAction> {
+    let mut cs = cow_state.lock().await;
+    if let Some(cow) = cs.branch.as_mut() {
+        let s = host_path.to_string_lossy();
+        if cow.matches(&s) {
+            let rel = cow.safe_rel(&s).ok_or(NotifAction::Errno(libc::EACCES))?;
+            return cow.ensure_cow_copy(&rel).map_err(|error| NotifAction::Errno(match error {
+                crate::error::BranchError::QuotaExceeded => libc::ENOSPC,
+                crate::error::BranchError::Deleted => libc::ENOENT,
+                _ => libc::EIO,
+            }));
+        }
+    }
+    Ok(host_path.to_path_buf())
+}
