+/// FUSE overlay directories count their merged child directories, but its inode
+/// cache can forget children between lookups. Count the actual view, including
+/// new directories and whiteouts, instead of exposing that partial cache count.
+fn mounted_directory_links(path: &Path, mode: libc::mode_t, links: u64) -> Option<u64> {
+    if mode & libc::S_IFMT != libc::S_IFDIR || links == 0 { return None; }
+    let name = path_cstr(path, libc::EINVAL).ok()?;
+    let mut filesystem: libc::statfs = unsafe { std::mem::zeroed() };
+    if unsafe { libc::statfs(name.as_ptr(), &mut filesystem) } != 0 || filesystem.f_type != libc::FUSE_SUPER_MAGIC { return None; }
+    std::fs::read_dir(path).ok()?.try_fold(2u64, |count, entry| {
+        entry?.file_type().map(|kind| count + u64::from(kind.is_dir()))
+    }).ok()
+}
