+/// Exec a script's interpreter in its place: inject the interpreter, opened where the kernel would find it (past
+/// exec-only substitution), and rewrite the call to `interpreter [argument] filename argv[1..]`. None keeps the fd exec.
+#[allow(clippy::too_many_arguments)]
+async fn exec_script(
+    notif: &SeccompNotif,
+    chroot_state: &Arc<Mutex<ChrootState>>,
+    notif_fd: RawFd,
+    ctx: &ChrootCtx<'_>,
+    script: RawFd,
+    filename: &str,
+    path_ptr: u64,
+    argv_ptr: u64,
+    envp_ptr: u64,
+) -> Option<NotifAction> {
+    let (interpreter, argument) = read_shebang(script)?;
+    let interpreter = String::from_utf8(interpreter).ok().filter(|name| name.starts_with('/'))?;
+    let interpreter_path = crate::chroot::resolve::confine(&interpreter);
+    if !ctx.can_read(&interpreter_path) {
+        return None;
+    }
+    let image = unsafe { OwnedFd::from_raw_fd(open_in_view(ctx, &interpreter_path)?) };
+    if !is_elf(image.as_raw_fd()) {
+        return None;
+    }
+    let addfd = SeccompNotifAddfd {
+        id: notif.id,
+        flags: 0,
+        srcfd: image.as_raw_fd() as u32,
+        newfd: 0,
+        newfd_flags: libc::O_CLOEXEC as u32,
+    };
+    let child_fd = unsafe { libc::ioctl(notif_fd, SECCOMP_IOCTL_NOTIF_ADDFD as libc::c_ulong, &addfd as *const _) };
+    if child_fd < 0 {
+        return Some(NotifAction::Errno(libc::EIO));
+    }
+    let mut prefix = vec![interpreter.into_bytes()];
+    prefix.extend(argument);
+    prefix.push(filename.as_bytes().to_vec());
+    // A layout that cannot take the longer argv keeps the fd exec; the injected interpreter is close-on-exec.
+    match crate::seccomp::notif::rewrite_script_exec(notif_fd, notif.id, notif.pid, path_ptr, argv_ptr, envp_ptr, child_fd, &prefix) {
+        Ok(true) => {}
+        Ok(false) => return None,
+        Err(_) => return Some(NotifAction::Errno(libc::EFAULT)),
+    }
+    chroot_state.lock().await.chroot_exe = Some(interpreter_path);
+    Some(NotifAction::Continue)
+}
