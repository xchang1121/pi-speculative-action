+fn open_owned_fd(pid: u32, fd: i32, flags: i32) -> Result<OwnedFd, i32> {
+    let pin = crate::seccomp::notif::dup_fd_from_pid(pid, fd).map_err(|_| libc::EBADF)?;
+    let mut state: libc::stat = unsafe { std::mem::zeroed() };
+    if unsafe { libc::fstat(pin.as_raw_fd(), &mut state) } == 0
+        && state.st_mode & libc::S_IFMT == libc::S_IFIFO
+        && flags & !(libc::O_NONBLOCK | libc::O_CLOEXEC | 0x8000) == 0
+        && unsafe { libc::fcntl(pin.as_raw_fd(), libc::F_GETFL) } & libc::O_ACCMODE == libc::O_RDONLY
+    {
+        // A proc-fd open creates an independent OFD over the same pipe queue.
+        // Reopen a pinned read end; never grant a writer or resolve another task's path.
+        let name = std::ffi::CString::new(format!("/proc/self/fd/{}", pin.as_raw_fd())).map_err(|_| libc::EINVAL)?;
+        let opened = unsafe { libc::open(name.as_ptr(), flags | libc::O_CLOEXEC) };
+        if opened < 0 { return Err(last_errno(libc::EIO)); }
+        return Ok(unsafe { OwnedFd::from_raw_fd(opened) });
+    }
+    Ok(pin)
+}
