+fn parse_cow_write(notif: &SeccompNotif, notif_fd: RawFd, virtual_cwd: Option<&str>) -> Option<CowWriteOp> {
+    let a = notif.data.args;
+    let path = |dirfd, pointer| read_path(notif, pointer, notif_fd)
+        .map(|raw| resolve_at_path_with_virtual(notif, dirfd, &raw, virtual_cwd));
+    Some(match notif.data.nr as i64 {
+        libc::SYS_unlinkat => CowWriteOp::Unlink {
+            path: path(a[0] as i64, a[1])?, is_dir: a[2] & libc::AT_REMOVEDIR as u64 != 0,
+        },
+        libc::SYS_mkdirat => CowWriteOp::Mkdir {
+            path: path(a[0] as i64, a[1])?, mode: crate::seccomp::notif::creation_mode(notif.pid, a[2]) & 0o1777,
+        },
+        libc::SYS_mknodat => CowWriteOp::Mknod {
+            path: path(a[0] as i64, a[1])?, mode: a[2] as u32, dev: a[3],
+        },
+        libc::SYS_renameat2 => CowWriteOp::Rename {
+            old_path: path(a[0] as i64, a[1])?, new_path: path(a[2] as i64, a[3])?,
+        },
+        // The symlink target is literal text; only the new entry resolves against a directory.
+        libc::SYS_symlinkat => CowWriteOp::Symlink {
+            target: read_path(notif, a[0], notif_fd)?, linkpath: path(a[1] as i64, a[2])?,
+        },
+        libc::SYS_linkat => CowWriteOp::Link {
+            old_path: path(a[0] as i64, a[1])?, new_path: path(a[2] as i64, a[3])?,
+        },
+        libc::SYS_fchmodat => CowWriteOp::Chmod {
+            path: path(a[0] as i64, a[1])?, mode: (a[2] & 0o7777) as u32,
+        },
+        libc::SYS_fchownat => CowWriteOp::Chown {
+            path: path(a[0] as i64, a[1])?, uid: a[2] as u32, gid: a[3] as u32,
+        },
+        libc::SYS_truncate => CowWriteOp::Truncate {
+            path: path(libc::AT_FDCWD as i64, a[0])?, length: a[1] as i64,
+        },
+        _ => return None,
+    })
