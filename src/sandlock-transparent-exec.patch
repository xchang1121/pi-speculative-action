+// Legacy ABIs differ only in their argument layout. Keep the layout next to
+// its canonical syscall and delegate all resolution, policy and side effects.
+macro_rules! legacy_chroot_handler {
+    ($name:ident, $handler:ident, $nr:expr, |$args:ident $(, $extra:ident: $ty:ty)*| $layout:expr) => {
+        pub(crate) async fn $name(
+            notif: &SeccompNotif,
+            chroot_state: &Arc<Mutex<ChrootState>>,
+            cow_state: &Arc<Mutex<CowState>>,
+            notif_fd: RawFd,
+            ctx: &ChrootCtx<'_>,
+            $($extra: $ty,)*
+        ) -> NotifAction {
+            let $args = notif.data.args;
+            let mut synth = notif_with_args(notif, $layout);
+            synth.data.nr = $nr as i32;
+            $handler(&synth, chroot_state, cow_state, notif_fd, ctx).await
+        }
+    };
 }

