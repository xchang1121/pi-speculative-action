+fn capture_input_image(cow: &mut crate::cow::seccomp::SeccompCowBranch, path: &Path, requested: &str,
+    metadata: &MetadataImage) -> std::io::Result<()> {
+    use std::fs::{self, OpenOptions};
+    use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
