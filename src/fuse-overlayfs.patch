+/* Complete the visible alias namespace before any inode reaches the kernel.
+   Every shared object then has one upper inode, including held read handles. */
+static int
+load_hardlink_tree (struct ovl_data *lo, struct ovl_node *directory, size_t *entries)
+{
+  struct ovl_node *node;
+  directory = reload_dir (lo, directory);
+  if (directory == NULL)
+    return -1;
+  for (node = hash_get_first (directory->children); node; node = hash_get_next (directory->children, node))
+    {
+      if (++*entries > 100000)
+        { errno = E2BIG; return -1; }
+      if (! node->whiteout && node_dirp (node) && load_hardlink_tree (lo, node, entries) < 0)
+        return -1;
+    }
+  return 0;
+}
+
+static int
+materialize_hardlinks (struct ovl_data *lo)
+{
+  struct ovl_ino *ino;
+  size_t entries = 0;
+  if (load_hardlink_tree (lo, lo->root, &entries) < 0)
+    return -1;
+  for (ino = hash_get_first (lo->inodes); ino; ino = hash_get_next (lo->inodes, ino))
+    {
+      struct ovl_node *node, *first = ino->node;
+      if (! S_ISREG (ino->mode) || first->next_link == NULL)
+        continue;
+      for (node = first; node; node = node->next_link)
+        if (node->layer == get_upper_layer (lo))
+          first = node;
+      if (get_node_up (lo, first) == NULL)
+        return -1;
+      for (node = ino->node; node; node = node->next_link)
+        {
+          if (node->layer == get_upper_layer (lo))
+            continue;
+          if (get_node_up (lo, node->parent) == NULL
+              || linkat (node_dirfd (first), first->path, get_upper_layer (lo)->fd, node->path, 0) < 0)
+            return -1;
+          node->layer = get_upper_layer (lo);
+        }
+    }
+  /* Copy-up needs writable ancestors only until initialization has completed. */
+  for (ino = hash_get_first (lo->inodes); ino; ino = hash_get_next (lo->inodes, ino))
+    if (node_dirp (ino->node) && ino->node->layer == get_upper_layer (lo)
+        && fchmodat (get_upper_layer (lo)->fd, ino->node->path, ino->mode & 07777, 0) < 0)
+      return -1;
+  return 0;
+}
