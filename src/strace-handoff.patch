+struct handoff_reply { int32_t pid, fd, syscall, reserved; uint64_t bytes, started, frontier; };
+static uint64_t handoff_clock(void)
+{
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now)) perror_msg_and_die("handoff clock");
+    return (uint64_t)now.tv_sec * 1000000000 + now.tv_nsec;
+}
+static void handoff_reply(struct handoff_reply reply)
+{
+    unsigned char *bytes = (unsigned char *)&reply;
+    size_t left = sizeof(reply);
+    while (left) {
+        ssize_t size = write(handoff_fd, bytes, left);
+        if (size < 0 && errno == EINTR) continue;
+        if (size <= 0) perror_msg_and_die("handoff reply");
+        left -= size; bytes += size;
+    }
+}
+static void handoff_signal(int sig) { (void)sig; handoff_requested = 1; }
+
+static void handoff_watch(struct tcb *tcp)
+{
+    struct user_regs_struct regs;
+    if (handoff_fd < 0 || entering(tcp) || tcp->scno != 218 || ptrace(PTRACE_GETREGS, tcp->pid, 0, &regs) < 0 ||
+        regs.orig_rax != 218 || (long)regs.rax < 0) return;
+    if (tcp->handoff_tid_state || !regs.rdi || (regs.rdi & 3) || regs.cs != 0x33) {
+        tcp->handoff_tid_state = 3;
+        return;
+    }
+    tcp->handoff_tid = regs.rdi; tcp->handoff_tid_value = regs.rax;
+    tcp->handoff_tid_state = 1;
+    if (ptrace(PTRACE_POKEUSER, tcp->pid, offsetof(struct user, u_debugreg[0]), regs.rdi) < 0 ||
+        ptrace(PTRACE_POKEUSER, tcp->pid, offsetof(struct user, u_debugreg[6]), 0) < 0 ||
+        ptrace(PTRACE_POKEUSER, tcp->pid, offsetof(struct user, u_debugreg[7]), 1 | (3 << 16) | (3 << 18)) < 0)
+        tcp->handoff_tid_state = 3;
+}
+
+static bool handoff_watch_stop(struct tcb *tcp, int status)
+{
+    if (handoff_fd < 0 || !tcp || !tcp->handoff_tid_state || !WIFSTOPPED(status) ||
+        WSTOPSIG(status) != SIGTRAP || (unsigned)status >> 16) return false;
+    errno = 0;
+    long cause = ptrace(PTRACE_PEEKUSER, tcp->pid, offsetof(struct user, u_debugreg[6]), 0);
+    if (errno || !(cause & 1)) return false;
+    struct user_regs_struct regs;
+    long value = ptrace(PTRACE_PEEKDATA, tcp->pid, tcp->handoff_tid, 0);
+    if (tcp->handoff_tid_state == 1 && !errno && (unsigned int)value == tcp->handoff_tid_value &&
+        ptrace(PTRACE_GETREGS, tcp->pid, 0, &regs) == 0) {
+        unsigned long words[2];
+        words[0] = ptrace(PTRACE_PEEKTEXT, tcp->pid, regs.rip - 8, 0);
+        words[1] = ptrace(PTRACE_PEEKTEXT, tcp->pid, regs.rip, 0);
+        const unsigned char *bytes = (const unsigned char *)words;
+        int32_t store_offset, kill_offset;
+        memcpy(&store_offset, bytes + 4, 4); memcpy(&kill_offset, bytes + 11, 4);
+        /* Kernel TID flows directly from syscall to the watched word, then RAX
+         * is overwritten without reading it. Unknown instruction shapes decline. */
+        if (!errno && !memcmp(bytes, "\x0f\x05\x89\x83", 4) && !memcmp(bytes + 8, "\x48\x8d\x83", 3) &&
+            regs.rbx + store_offset == tcp->handoff_tid && (unsigned int)regs.rax == tcp->handoff_tid_value) {
+            struct user_regs_struct after;
+            int stepped; pid_t waited;
+            if (ptrace(PTRACE_SINGLESTEP, tcp->pid, 0, 0) < 0) perror_msg_and_die("handoff initialization step");
+            do { waited = waitpid(tcp->pid, &stepped, __WALL); } while (waited < 0 && errno == EINTR);
+            if (waited != tcp->pid ||
+                !WIFSTOPPED(stepped) || WSTOPSIG(stepped) != SIGTRAP || (unsigned)stepped >> 16 ||
+                ptrace(PTRACE_GETREGS, tcp->pid, 0, &after) < 0 || after.rip != regs.rip + 7 || after.rax != regs.rbx + kill_offset)
+                error_msg_and_die("handoff TID initialization interrupted");
+            tcp->handoff_tid_state = 2;
+        } else tcp->handoff_tid_state = 3;
+    } else {
+        tcp->handoff_tid_state = 3;
+        ptrace(PTRACE_POKEUSER, tcp->pid, offsetof(struct user, u_debugreg[7]), 0);
+    }
+    if (tcp->handoff_tid_state == 3) {
+        if (ptrace(PTRACE_POKEUSER, tcp->pid, offsetof(struct user, u_debugreg[7]), 0) < 0) perror_msg_and_die("handoff watch disarm");
+        if (handoff_pid == tcp->pid) { handoff_pid = 0; handoff_reply((struct handoff_reply){0}); }
+    }
+    if (ptrace(PTRACE_POKEUSER, tcp->pid, offsetof(struct user, u_debugreg[6]), 0) < 0 ||
+        ptrace(PTRACE_SYSCALL, tcp->pid, 0, 0) < 0) perror_msg_and_die("handoff watch restart");
+    return true;
+}
+
+static void handoff_request(void)
+{
+    if (!handoff_requested) return;
+    handoff_requested = 0;
+    pid_t pid;
+    ssize_t size = recv(handoff_fd, &pid, sizeof(pid), MSG_DONTWAIT);
+    if (size < 0 && (errno == EAGAIN || errno == EINTR)) return;
+    if (size != sizeof(pid) || pid <= 0 || handoff_pid) error_msg_and_die("invalid handoff request");
+    struct tcb *tcp = pid2tcb(pid);
+    if (!tcp || tcp->handoff_tid_state == 1 || tcp->handoff_tid_state == 3 || ptrace(PTRACE_INTERRUPT, pid, 0, 0) < 0) {
+        handoff_reply((struct handoff_reply){0}); return;
+    }
+    handoff_pid = pid;
+}
